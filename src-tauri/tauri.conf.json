{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Swatted.wtf",
  "version": "0.1.0",
  "identifier": "tf.swattedw.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Swatted.wtf",
        "width": 520,
        "height": 620,
        "resizable": false,
        "decorations": false,
        "transparent": false,
        "center": true,
        "backgroundColor": "#0b0b0b"
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; connect-src 'self' ipc: http://ipc.localhost; base-uri 'none'; form-action 'none'; object-src 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "msi",
      "nsis",
      "deb",
      "appimage"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "publisher": "swatted.wtf",
    "shortDescription": "Open-source desktop client for swatted.wtf",
    "longDescription": "Open-source desktop client for the swatted.wtf OSINT platform.",
    "resources": [
      "resources/integrity.json"
    ]
  },
  "plugins": {
    "updater": {
      "active": true,
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDNCODE0QzExMkYwN0I5MjkKUldRcHVRY3ZFVXlCTzdLQXZCUzBtUVpML1RRalRib0hNMjJqeTNqRmhSd2MrWGJVL3RNeWRGajYK",
      "endpoints": [
        "https://github.com/swattedwtf/swattedwtf-app/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
